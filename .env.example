# Copy to .env (gitignored) and fill in. Any OpenAI-compatible endpoint works.
OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_API_KEY=
# Optional: separate endpoint for the DeepSeek entry (falls back to OPENAI_*)
# DEEPSEEK_BASE_URL=
# DEEPSEEK_API_KEY=
# Optional model-id overrides if your gateway names models differently (see configs/models.toml)
# CRYSTALSIGHT_MODEL_DEEPSEEK=deepseek-v4-flash
# CRYSTALSIGHT_MODEL_GEMINI=gemini-2.5-flash
